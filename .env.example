# ---------------------------------------------------------------------------
# Copy to .env and `set -a && source .env && set +a` before running the apps.
# .env is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Control plane (cfp-admin only) -------------------------------------
# Auth comes from DefaultAzureCredential. The simplest path is `az login`.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=cfp-tutorial-rg

# Account name must be globally unique, 3-44 chars, lowercase alphanumeric + '-'.
COSMOS_ACCOUNT_NAME=cfp-tutorial-<yourinitials>

# --- Data plane (cfp-writer / cfp-reader) -------------------------------
# `cfp-admin provision` prints these; export them afterwards.
ACCOUNT_HOST=https://<account>.documents.azure.com:443/
ACCOUNT_KEY=<primary-master-key>

# --- Shared naming (all apps; these defaults are fine) ------------------
COSMOS_DATABASE=cfpdb
COSMOS_CONTAINER=sensor-readings
COSMOS_LEASE_CONTAINER=leases
COSMOS_PREFERRED_REGION=South Central US
